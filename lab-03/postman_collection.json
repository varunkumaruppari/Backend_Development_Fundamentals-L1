{
  "info": {
    "name": "Lab 3 - REST API",
    "description": "Success and failure cases for the Lab 3 book store API. Start the server with npm run dev in lab-03 before running them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "01 GET all books",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/" }
    },
    {
      "name": "02 GET search by title",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/?search_q=habit" }
    },
    {
      "name": "03 GET price range",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/?min_price=300&max_price=400" }
    },
    {
      "name": "04 GET sort by price desc",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/?order_by=price&order=DESC&limit=3" }
    },
    {
      "name": "05 GET pagination",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/?limit=2&offset=8" }
    },
    {
      "name": "06 GET one book",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/1/" }
    },
    {
      "name": "07 POST add book",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"The Pragmatic Programmer\",\n  \"author\": \"Andrew Hunt\",\n  \"price\": 500,\n  \"pages\": 352\n}" },
        "url": "{{baseUrl}}/books/"
      }
    },
    {
      "name": "08 POST missing author",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"No Author Book\",\n  \"price\": 200,\n  \"pages\": 100\n}" },
        "url": "{{baseUrl}}/books/"
      }
    },
    {
      "name": "09 POST price not a number",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Bad Price\",\n  \"author\": \"Someone\",\n  \"price\": \"free\",\n  \"pages\": 100\n}" },
        "url": "{{baseUrl}}/books/"
      }
    },
    {
      "name": "10 PUT update book",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Atomic Habits (Updated)\",\n  \"author\": \"James Clear\",\n  \"price\": 475,\n  \"pages\": 330\n}" },
        "url": "{{baseUrl}}/books/1/"
      }
    },
    {
      "name": "11 DELETE book",
      "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/books/10/" }
    },
    {
      "name": "12 GET unknown id",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/999/" }
    },
    {
      "name": "13 GET invalid id",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/abc/" }
    },
    {
      "name": "14 GET bad query parameter",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/?order_by=price;DROP%20TABLE%20book" }
    }
  ]
}
